{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/proposal",       "destination": "/proposal/index.html" },
    { "source": "/proposal/(.*)", "destination": "/proposal/$1" },
    { "source": "/(.*)",           "destination": "/index.html" }
  ]
}
